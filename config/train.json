{
  "models": ["reg_logistic"],
  "train_pooled": false,
  "use_validation": true,
  "group_splits": ["sex_age65"],
  "fixed_group_params": {
    "under_65": {"lambda": 1e-6, "gamma": 0.1, "max_iters": 250},
    "age_65_plus": {"lambda": 1e-6, "gamma": 0.2, "max_iters": 210}
  },
  "age_cutoff": 65,
  "positive_class_cost": 2.0,
  "val_fraction": 0.2,
  "seed": 42,
  "submission_dir": "submissions",
  "use_gpu": false,
  "early_stopping": {
    "patience": 5,
    "min_auc_gain": 0.0001,
    "metric": "f1",
    "max_iters": {
      "gd": 2000,
      "sgd": 200000,
      "logistic": 500,
      "reg_logistic": 500
    },
    "eval_every": {
      "gd": 25,
      "sgd": 5000,
      "logistic": 10,
      "reg_logistic": 10
    }
  },
  "grids": {
    "ridge_lambda": [1e-6, 0.0001, 0.001, 0.01, 0.1],
    "reg_logistic_lambda": [1e-6, 1e-5, 0.0001, 0.001],
    "gd_gamma": [0.01, 0.02, 0.05, 0.08],
    "sgd_gamma": [1e-5, 5e-5, 0.0001, 0.0002],
    "logistic_gamma": [0.01, 0.05, 0.1, 0.2]
  }
}
